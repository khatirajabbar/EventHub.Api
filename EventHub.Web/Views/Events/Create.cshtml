@model EventHub.Web.Models.DTOs.EventCreateDto

@{
    ViewData["Title"] = "Create Event";
}

<style>
    :root {
        --ink: #0a0a0a;
        --paper: #f5f2eb;
        --accent: #e8401a;
        --muted: #888880;
        --border: #d0cdc4;
    }
    body { background: var(--paper); color: var(--ink); }
    .form-page { padding: 48px 0; }
    .form-page-label { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
    .form-page-title { font-family: 'Playfair Display', serif; font-size: 2.5rem; font-weight: 700; letter-spacing: -0.03em; margin-bottom: 40px; padding-bottom: 24px; border-bottom: 2px solid var(--ink); }
    .form-group { margin-bottom: 28px; }
    .form-group label { display: block; font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
    .form-group input, .form-group textarea { width: 100%; border: 1px solid var(--border); background: #faf8f4; padding: 12px 16px; font-family: 'Lora', serif; font-size: 1rem; color: var(--ink); outline: none; transition: border-color 0.15s; border-radius: 0; -webkit-appearance: none; }
    .form-group input:focus, .form-group textarea:focus { border-color: var(--ink); background: #fff; }
    .form-group textarea { resize: vertical; min-height: 120px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .btn-submit { background: var(--ink); color: #fff; font-family: 'DM Mono', monospace; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; padding: 14px 32px; border: none; cursor: pointer; transition: background 0.15s; }
    .btn-submit:hover { background: var(--accent); }
    .btn-submit:disabled { opacity: 0.5; cursor: not-allowed; }
    .back-link { font-family: 'DM Mono', monospace; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); text-decoration: none; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 32px; transition: color 0.15s; }
    .back-link:hover { color: var(--ink); text-decoration: none; }
    .validation-message { color: #e53935; font-family: 'DM Mono', monospace; font-size: 11px; margin-top: 6px; }
    .upload-area { border: 1px dashed var(--border); background: #faf8f4; padding: 32px; text-align: center; cursor: pointer; transition: border-color 0.15s, background 0.15s; position: relative; }
    .upload-area:hover, .upload-area.dragover { border-color: var(--ink); background: #fff; }
    .upload-area input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; padding: 0; border: none; }
    .upload-label { font-family: 'DM Mono', monospace; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); pointer-events: none; }
    .upload-preview { margin-top: 12px; display: none; }
    .upload-preview img { max-height: 160px; max-width: 100%; object-fit: cover; border: 1px solid var(--border); }
    .upload-filename { font-family: 'DM Mono', monospace; font-size: 11px; color: var(--muted); margin-top: 8px; }
    .upload-status { font-family: 'DM Mono', monospace; font-size: 11px; margin-top: 8px; display: none; }
    .upload-status.uploading { color: var(--muted); display: block; }
    .upload-status.success { color: #2e7d32; display: block; }
    .upload-status.error { color: #e53935; display: block; }
    
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=DM+Mono:wght@400;500&family=Lora&display=swap" rel="stylesheet">

<div class="container form-page" style="max-width:720px">
    <a href="@Url.Action("Index", "Events")" class="back-link">← Back to events</a>
    <p class="form-page-label">Admin</p>
    <h1 class="form-page-title">Create Event</h1>

    <form asp-controller="Events" asp-action="Create" method="post" id="createForm">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label asp-for="Title">Title</label>
            <input asp-for="Title" placeholder="Event title" />
            <span asp-validation-for="Title" class="validation-message"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" placeholder="Describe the event…"></textarea>
            <span asp-validation-for="Description" class="validation-message"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Date">Date & Time</label>
                <input asp-for="Date" type="datetime-local" />
                <span asp-validation-for="Date" class="validation-message"></span>
            </div>
            <div class="form-group">
                <label asp-for="Location">Location</label>
                <input asp-for="Location" placeholder="City, Venue" />
                <span asp-validation-for="Location" class="validation-message"></span>
            </div>
        </div>

        <div class="form-group">
            <label>Banner Image</label>
            <div class="upload-area" id="uploadArea">
                <input type="file" id="bannerFile" accept="image/*" />
                <div class="upload-label" id="uploadLabel">Click or drag to upload (JPG, PNG, GIF, WebP — max 5MB)</div>
                <div class="upload-preview" id="uploadPreview">
                    <img id="previewImg" src="" alt="Preview">
                    <div class="upload-filename" id="uploadFilename"></div>
                </div>
            </div>
            <div class="upload-status" id="uploadStatus"></div>
            <input asp-for="BannerImageUrl" type="hidden" id="bannerImageUrl" />
        </div>

        <div class="form-group">
            <label asp-for="OrganizerId">Organizer</label>
            <select asp-for="OrganizerId"
                    asp-items="@(new SelectList(ViewBag.Organizers, "Id", "Name"))">
                <option value="">— Select organizer —</option>
            </select>
            <span asp-validation-for="OrganizerId" class="validation-message"></span>
        </div>

        <button type="submit" class="btn-submit" id="submitBtn">Create Event</button>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const fileInput = document.getElementById('bannerFile');
        const uploadArea = document.getElementById('uploadArea');
        const uploadLabel = document.getElementById('uploadLabel');
        const uploadPreview = document.getElementById('uploadPreview');
        const previewImg = document.getElementById('previewImg');
        const uploadFilename = document.getElementById('uploadFilename');
        const uploadStatus = document.getElementById('uploadStatus');
        const bannerImageUrl = document.getElementById('bannerImageUrl');
        const submitBtn = document.getElementById('submitBtn');
        const createForm = document.getElementById('createForm');

        uploadArea.addEventListener('dragover', e => { e.preventDefault(); uploadArea.classList.add('dragover'); });
        uploadArea.addEventListener('dragleave', () => uploadArea.classList.remove('dragover'));
        uploadArea.addEventListener('drop', e => {
            e.preventDefault();
            uploadArea.classList.remove('dragover');
            if (e.dataTransfer.files[0]) { fileInput.files = e.dataTransfer.files; handleFileSelected(e.dataTransfer.files[0]); }
        });

        fileInput.addEventListener('change', () => { if (fileInput.files[0]) handleFileSelected(fileInput.files[0]); });

        function handleFileSelected(file) {
            uploadLabel.style.display = 'none';
            uploadFilename.textContent = file.name;
            uploadPreview.style.display = 'block';
            const reader = new FileReader();
            reader.onload = e => previewImg.src = e.target.result;
            reader.readAsDataURL(file);
        }

        createForm.addEventListener('submit', async function(e) {
            if (!fileInput.files[0]) return; // no file, submit normally

            e.preventDefault();
            submitBtn.disabled = true;
            submitBtn.textContent = 'Creating…';

            const formData = new FormData(createForm);
            const response = await fetch(createForm.action, { method: 'POST', body: formData });

            if (response.redirected) {
                const redirectUrl = response.url;
                const match = redirectUrl.match(/\/Events\/Details\/(\d+)/i);
                if (match) {
                    const eventId = match[1];
                    uploadStatus.className = 'upload-status uploading';
                    uploadStatus.textContent = 'Uploading banner…';

                    const bannerData = new FormData();
                    bannerData.append('file', fileInput.files[0]);

                    try {
                        const uploadResponse = await fetch(`http://localhost:5220/api/events/${eventId}/banner`, {
                            method: 'POST',
                            body: bannerData
                        });
                        if (uploadResponse.ok) {
                            uploadStatus.className = 'upload-status success';
                            uploadStatus.textContent = 'Banner uploaded!';
                        } else {
                            uploadStatus.className = 'upload-status error';
                            uploadStatus.textContent = 'Banner upload failed, but event was created.';
                        }
                    } catch (err) {
                        uploadStatus.className = 'upload-status error';
                        uploadStatus.textContent = 'Banner upload failed: ' + err.message;
                    }
                }
                window.location.href = redirectUrl;
            } else {
                const html = await response.text();
                document.open(); document.write(html); document.close();
            }
        });
    </script>
}
