@model EventHub.Web.Models.DTOs.TicketCreateDto

@{
    var ev = ViewBag.Event as EventHub.Web.Models.DTOs.EventResponseDto;
    ViewData["Title"] = "Add Ticket";
}

<style>
    :root { --ink: #0a0a0a; --paper: #f5f2eb; --accent: #e8401a; --muted: #888880; --border: #d0cdc4; }
    body { background: var(--paper); color: var(--ink); }
    .form-page { padding: 48px 0; }
    .form-page-label { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
    .form-page-title { font-family: 'Playfair Display', serif; font-size: 2.5rem; font-weight: 700; letter-spacing: -0.03em; margin-bottom: 8px; padding-bottom: 24px; border-bottom: 2px solid var(--ink); }
    .event-context { font-family: 'DM Mono', monospace; font-size: 11px; color: var(--muted); margin-bottom: 40px; letter-spacing: 0.06em; }
    .form-group { margin-bottom: 28px; }
    .form-group label { display: block; font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
    .form-group input, .form-group select { width: 100%; border: 1px solid var(--border); background: #faf8f4; padding: 12px 16px; font-family: 'Lora', serif; font-size: 1rem; color: var(--ink); outline: none; transition: border-color 0.15s; border-radius: 0; -webkit-appearance: none; }
    .form-group input:focus, .form-group select:focus { border-color: var(--ink); background: #fff; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .btn-submit { background: var(--ink); color: #fff; font-family: 'DM Mono', monospace; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; padding: 14px 32px; border: none; cursor: pointer; transition: background 0.15s; }
    .btn-submit:hover { background: var(--accent); }
    .back-link { font-family: 'DM Mono', monospace; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); text-decoration: none; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 32px; transition: color 0.15s; }
    .back-link:hover { color: var(--ink); text-decoration: none; }
    .validation-message { color: #e53935; font-family: 'DM Mono', monospace; font-size: 11px; margin-top: 6px; }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=DM+Mono:wght@400;500&family=Lora&display=swap" rel="stylesheet">

<div class="container form-page" style="max-width:560px">
    <a href="@Url.Action("Details", "Events", new { id = ev?.Id })" class="back-link">← Back to event</a>
    <p class="form-page-label">Admin</p>
    <h1 class="form-page-title">Add Ticket</h1>
    @if (ev != null)
    {
        <div class="event-context">For: @ev.Title</div>
    }

    <form asp-action="CreateTicket" asp-route-eventId="@ev?.Id" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-message" style="margin-bottom:20px"></div>

        <div class="form-group">
            <label asp-for="Type">Ticket Type</label>
            <select asp-for="Type">
                <option value="">— Select type —</option>
                <option value="General">General</option>
                <option value="VIP">VIP</option>
                <option value="Regular">Regular</option>
                <option value="Student">Student</option>
                <option value="EarlyBird">Early Bird</option>
                <option value="Premium">Premium</option>
            </select>
            <span asp-validation-for="Type" class="validation-message"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Price">Price ($)</label>
                <input asp-for="Price" type="number" step="0.01" min="0" placeholder="0.00" />
                <span asp-validation-for="Price" class="validation-message"></span>
            </div>
            <div class="form-group">
                <label asp-for="QuantityAvailable">Quantity</label>
                <input asp-for="QuantityAvailable" type="number" min="1" placeholder="100" />
                <span asp-validation-for="QuantityAvailable" class="validation-message"></span>
            </div>
        </div>

        <button type="submit" class="btn-submit">Add Ticket →</button>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}