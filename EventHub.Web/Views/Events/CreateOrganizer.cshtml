@model EventHub.Web.Models.DTOs.OrganizerCreateDto

@{
    ViewData["Title"] = "Create Organizer";
}

<style>
    :root { --ink: #0a0a0a; --paper: #f5f2eb; --accent: #e8401a; --muted: #888880; --border: #d0cdc4; }
    body { background: var(--paper); color: var(--ink); }
    .form-page { padding: 48px 0; }
    .form-page-label { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
    .form-page-title { font-family: 'Playfair Display', serif; font-size: 2.5rem; font-weight: 700; letter-spacing: -0.03em; margin-bottom: 40px; padding-bottom: 24px; border-bottom: 2px solid var(--ink); }
    .form-group { margin-bottom: 28px; }
    .form-group label { display: block; font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
    .form-group input { width: 100%; border: 1px solid var(--border); background: #faf8f4; padding: 12px 16px; font-family: 'Lora', serif; font-size: 1rem; color: var(--ink); outline: none; transition: border-color 0.15s; border-radius: 0; }
    .form-group input:focus { border-color: var(--ink); background: #fff; }
    .btn-submit { background: var(--ink); color: #fff; font-family: 'DM Mono', monospace; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; padding: 14px 32px; border: none; cursor: pointer; transition: background 0.15s; }
    .btn-submit:hover { background: var(--accent); }
    .back-link { font-family: 'DM Mono', monospace; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); text-decoration: none; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 32px; transition: color 0.15s; }
    .back-link:hover { color: var(--ink); text-decoration: none; }
    .validation-message { color: #e53935; font-family: 'DM Mono', monospace; font-size: 11px; margin-top: 6px; }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=DM+Mono:wght@400;500&family=Lora&display=swap" rel="stylesheet">

<div class="container form-page" style="max-width:560px">
    <a href="@Url.Action("Create", "Events")" class="back-link">← Back to create event</a>
    <p class="form-page-label">Admin</p>
    <h1 class="form-page-title">Create Organizer</h1>

    <form asp-action="CreateOrganizer" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-message" style="margin-bottom:20px"></div>

        <div class="form-group">
            <label asp-for="Name">Name</label>
            <input asp-for="Name" placeholder="Organizer name" />
            <span asp-validation-for="Name" class="validation-message"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" placeholder="contact@organizer.com" />
            <span asp-validation-for="Email" class="validation-message"></span>
        </div>

        <div class="form-group">
            <label asp-for="Phone">Phone (optional)</label>
            <input asp-for="Phone" placeholder="+1 234 567 8900" />
            <span asp-validation-for="Phone" class="validation-message"></span>
        </div>

        <button type="submit" class="btn-submit">Create Organizer →</button>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}